{
  "expo": {
    "name": "RM Frotas",
    "slug": "rm-frotas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080B0C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rmfrotas.app"
    },
    "android": {
      "package": "com.rmfrotas.app",
      "adaptiveIcon": {
        "backgroundColor": "#080B0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "versionCode": 1
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O RM Frotas precisa de acesso contínuo à sua localização para rastrear a viagem em andamento mesmo em segundo plano.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ]
  }
}
